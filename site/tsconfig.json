{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    // O gsap declara os tipos de plugins em ficheiros minúsculos (flip.d.ts) mas o exports-map
    // e o runtime usam maiúsculo (gsap/Flip → Flip.js). Em FS case-insensitive (macOS) o TS vê
    // o MESMO ficheiro com dois casings → TS1149 (falso positivo; no Linux/VPS resolve certo).
    // Relaxamos SÓ esta regra cosmética; strict e todo o type-check continuam ligados.
    "forceConsistentCasingInFileNames": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
