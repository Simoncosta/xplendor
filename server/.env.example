APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Integrações externas
# OpenAI — obrigatória para geração de descrições e análises IA
OPENAI_KEY=

# ─── PingWin (POS GrupoPIE cloud) — valores GLOBAIS, iguais a TODOS os ────────
# restaurantes. Por empresa guardam-se só username, database e senha (cifrada).
PINGWIN_AUTH_URL=https://srv-soa.mycloudpie.com:8136
PINGWIN_API_URL=https://srv-soa.mycloudpie.com:8136
# frontend_url VARIA por restaurante → deriva de https://{database}.mycloudpie.com.
# Deixar VAZIO para derivar; preencher só como override manual (raro).
PINGWIN_FRONTEND_URL=
PINGWIN_APP_VERSION=2026.01.09
PINGWIN_APPLICATION=pbo_soa_2026.0
PINGWIN_APP_GRUPOPIE=PBOWEB
# PINGWIN_REPORT_ID_SALES: ID do relatório "Resumo de Vendas" do GrupoPIE.
# ASSUMIDO global (igual a todos os restaurantes) — mas só confirmado com 1 restaurante (Yuko).
# ⚠️ SE UM RESTAURANTE NOVO NÃO PUXAR VENDAS, VERIFICAR ISTO PRIMEIRO: o report_id dele pode ser diferente.
# Como confirmar: DevTools no PingWin dele → gerar Resumo de Vendas → ver 'report.id' no corpo do POST /service/report.
PINGWIN_REPORT_ID_SALES=
PINGWIN_STORES=
PINGWIN_STORES_DATASET_ID=
# Allowlist de hosts (segurança). Vazio = sem restrição (dev). Uma entrada de
# domínio ('mycloudpie.com') cobre os subdomínios por restaurante.
PINGWIN_ALLOWED_HOSTS=srv-soa.mycloudpie.com,mycloudpie.com

VITE_APP_NAME="${APP_NAME}"
