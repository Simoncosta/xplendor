# Site do consultor: variáveis do contentor xplendor-consultor.
# A API do site na XPLENDOR (rede interna em produção).
CONSULTOR_API_URL=http://xplendor-nginx:8080/api/public/site/v1
# O token do contentor (php artisan consultor:site-token). Só existe aqui e, em hash, na XPLENDOR.
CONSULTOR_API_TOKEN=
# O segredo da revalidação (o mesmo de CONSULTOR_REVALIDATE_SECRET no Laravel).
CONSULTOR_REVALIDATE_SECRET=
# Só dev: mapa de hosts (host do pedido = host do site), separado por vírgulas. Ignorado em produção.
CONSULTOR_DEV_HOSTS=
# O fornecedor de mosaicos do mapa (https://…/{z}/{x}/{y}…) e a atribuição que ele exige. Vazio: imagem estática.
# Recomendado: Stadia Maps, estilo Alidade Smooth (plano Starter para uso comercial; autenticação pelo domínio):
#   MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png
#   MAP_ATTRIBUTION=&copy; <a href="https://stadiamaps.com/">Stadia Maps</a> &copy; <a href="https://openmaptiles.org/">OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
MAP_TILE_URL=
MAP_ATTRIBUTION=
